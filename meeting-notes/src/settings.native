<column padding="18" gap="16" background="background">
  <column gap="4">
    <text><span weight="bold" scale="1.3">Settings</span></text>
    <text size="sm" foreground="text_muted">OpenAI GPT-5.6 Luna</text>
  </column>

  <panel padding="18" background="surface" radius="lg" border-color="border" label="OpenAI API key settings">
    <column gap="10">
      <row gap="8" cross="center">
        <text grow="1"><span weight="bold">API key</span></text>
        <badge variant="secondary">{keyStatus}</badge>
      </row>
      <text-field text="{apiKeyDraft}" placeholder="sk-..." on-input="api_key_changed" on-submit="save_api_key" disabled="{areKeyControlsDisabled}" label="Replace OpenAI API key" />
      <button variant="primary" on-press="save_api_key" disabled="{isBusy}" label="Save OpenAI API key">Save API Key</button>
      <row gap="8">
        <button grow="1" variant="outline" on-press="open_api_keys" label="Open the OpenAI API keys page">Get an OpenAI API Key</button>
        <button variant="destructive" on-press="delete_api_key" disabled="{areKeyControlsDisabled}" label="Delete saved OpenAI key">Delete Key</button>
      </row>
      <text size="sm" foreground="text_muted" wrap="true">{detail}</text>
    </column>
  </panel>

  <alert text="The key is stored in macOS Keychain. Audio stays on this Mac; only meeting transcripts are sent to OpenAI for summarization." />
  <spacer grow="1" />
</column>
